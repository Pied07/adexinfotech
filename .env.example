# Required for Payload CMS. Use your cloud provider's pooled PostgreSQL URL
# when available, and include sslmode=require as required by that provider.
PAYLOAD_SECRET=replace-with-a-long-random-secret
DATABASE_URI=postgresql://USER:PASSWORD@YOUR-CLOUD-POSTGRES-HOST:5432/DATABASE?sslmode=require
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Starter imagery for the public site. Replace URLs or upload custom images in Payload.
NEXT_PUBLIC_HERO_IMAGE_URL=https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=1800&q=85
NEXT_PUBLIC_ABOUT_IMAGE_URL=https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1400&q=85
NEXT_PUBLIC_SERVICE_IMAGE_URL=https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1200&q=85
NEXT_PUBLIC_SERVICE_IMAGE_ONE=https://images.unsplash.com/photo-1558655146-d09347e92766?auto=format&fit=crop&w=1200&q=85
NEXT_PUBLIC_SERVICE_IMAGE_TWO=https://images.unsplash.com/photo-1691073121676-1ab3a6d3d743?auto=format&fit=crop&w=1200&q=85
NEXT_PUBLIC_SERVICE_IMAGE_THREE=https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1200&q=85
NEXT_PUBLIC_BLOG_IMAGE_URL=https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1200&q=85

# Optional Cloudinary image storage. Set all three to enable cloud media uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Fallback identity while you configure Site settings in /admin
NEXT_PUBLIC_BUSINESS_NAME=MARSMENT
NEXT_PUBLIC_TAGLINE=Web • Development • Marketing
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional transactional email provider (configure in your deployment)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
CONTACT_FROM_EMAIL=
